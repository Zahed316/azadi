{
  "permissions": {
    "allow": [
      "Shell(ls -la ~/.gemini/antigravity-cli/mcp/ 2>&1; echo \"---\"; ls -la ~/.commandcode/ 2>&1)",
      "Shell(ls -la ~/.gemini/antigravity-cli/mcp/ 2>&1; echo \"---\"; ls -la ~/.gemini/antigravity-cli/mcp/*/ 2>&1 | head -80)",
      "Shell(ls -la ~/.commandcode/projects/ 2>&1; echo \"---\"; find ~/.commandcode -maxdepth 3 -name \"mcp*\" 2>/dev/null)",
      "Shell(grep -l \"mcpServers\\|mcp_servers\\|\\\"servers\\\"\" ~/.gemini/antigravity-cli/settings.json ~/.gemini/antigravity-cli/jetski_state.pbtxt ~/.gemini/config/* 2>/dev/null; echo \"---builtin---\"; ls -la ~/.gemini/antigravity-cli/builtin/ ~/.gemini/config/ 2>&1)",
      "Shell(find ~/.commandcode -name \"mcp.json\" -o -name \".mcp.json\" 2>/dev/null; echo \"---\"; cat ~/.commandcode/mcp.json 2>&1)"
    ],
    "deny": [],
    "defaultMode": "default"
  }
}